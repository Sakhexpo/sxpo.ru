---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedTours from '../components/FeaturedTours.astro';
import MoreTours from '../components/MoreTours.astro';
import { withBase } from '../lib/paths';
import home from '../content/pages/home.json';
import settings from '../content/settings/site.json';
const orgData = { '@context': 'https://schema.org', '@type': 'TravelAgency', name: 'САХЭКСПО', url: 'https://sxpo.ru/', telephone: settings.phone, address: { '@type': 'PostalAddress', streetAddress: settings.address, addressLocality: 'Хабаровск', addressRegion: 'Хабаровский край', postalCode: '680000', addressCountry: 'RU' } };
---
<BaseLayout title={home.seoTitle} description={home.seoDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(orgData)} />
  <section class="winter-hero">
    <div class="winter-hero-glow" aria-hidden="true"></div>
    <div class="wrap winter-hero-inner">
      <div class="winter-hero-copy">
        <span class="eyebrow"><i></i> {home.heroEyebrow}</span>
        <h1>{home.heroTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{index === 2 ? <em>{line}</em> : line}</>)}</h1>
        <p>{home.heroDescription}</p>
        <div class="hero-actions"><a class="button" href={withBase('/tours')}>{home.heroButton} <span aria-hidden="true">↗</span></a><button class="hero-secondary-button" type="button" data-booking-open>Подобрать поездку</button></div>
        <div class="winter-proof"><span>САХЭКСПО</span><i></i><span>Туроператор · РТО № 000321</span><i></i><span>Из Хабаровска</span></div>
      </div>
      <div class="winter-hero-art">
        <img src={withBase(home.heroImage || '/images/winter/winter-17.webp')} alt="Зимний фестиваль ледяных скульптур в Китае" width="900" height="1100" fetchpriority="high" />
        <div class="winter-hero-caption"><span>{home.heroCaptionText}</span><strong>{home.heroCaptionTitle}</strong></div>
        <span class="winter-orbit winter-orbit-one" aria-hidden="true"></span><span class="winter-orbit winter-orbit-two" aria-hidden="true"></span>
      </div>
    </div>
    <div class="winter-hero-bottom wrap"><span>Листайте подборку зимних маршрутов</span><span aria-hidden="true">↓</span></div>
  </section>

  <FeaturedTours />
  <MoreTours />

  <section class="trust-strip" aria-label="Преимущества САХЭКСПО"><div class="wrap trust-items">
    {home.trustItems?.map((item, index) => <div class:list={["trust-card", index === 2 && "trust-certificate"]}><span class:list={["trust-icon", ["trust-icon-green", "trust-icon-blue", "trust-icon-gold", "trust-icon-orange"][index]]} aria-hidden="true">{["✦", "⌖", "✓", "♡"][index]}</span><div><b>{item.title}</b><span>{item.text}</span>{index === 2 && <small>САХЭКСПО · реестр туроператоров</small>}</div></div>)}
  </div></section>

  <section class="section home-directions" id="directions"><div class="wrap">
    <div class="section-heading"><div><span class="eyebrow eyebrow-dark">{home.directionsEyebrow}</span><h2>{home.directionsTitle}</h2></div><p>{home.directionsDescription}</p></div>
    <div class="winter-direction-grid">
      {home.directions?.map((direction, index) => <a href={withBase(`/tours?direction=${encodeURIComponent(direction.title)}`)}><span>0{index + 1}</span><strong>{direction.title}</strong><small>{direction.text}</small><i>↗</i></a>)}
    </div>
  </div></section>

  <section class="section home-about"><div class="wrap home-about-inner">
    <div><span class="eyebrow eyebrow-dark">{home.aboutEyebrow}</span><h2>{home.aboutTitle}</h2></div>
    <div><p>{home.aboutText}</p><a class="text-link" href={withBase('/about')}>О компании <span aria-hidden="true">↗</span></a></div>
  </div></section>

  <section class="home-gallery-links"><div class="wrap home-gallery-grid">
    <a href={withBase('/photos')}><span class="eyebrow">{home.galleryPhotosEyebrow}</span><strong>{home.galleryPhotosTitle}</strong><span class="gallery-link-arrow">↗</span><img src={withBase('/images/gallery/china-01.webp')} alt="Пейзажи и города Китая" loading="lazy" /></a>
    <a href={withBase('/videos')}><span class="eyebrow">{home.galleryVideosEyebrow}</span><strong>{home.galleryVideosTitle}</strong><span class="gallery-link-arrow">↗</span><img src={withBase('/images/winter/winter-03.webp')} alt="Вечерняя улица зимнего Китая" loading="lazy" /></a>
  </div></section>

  <section class="contact-band"><div class="wrap contact-inner"><div><span class="eyebrow">{home.contactEyebrow}</span><h2>{home.contactTitle}</h2><p>{home.contactText}</p></div><button class="button button-light" type="button" data-booking-open>{home.contactButton} <span>↗</span></button></div></section>
</BaseLayout>
