---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import about from '../../content/pages/about.json';
import settings from '../../content/settings/site.json';
---
<BaseLayout title={about.seoTitle} description={about.seoDescription}>
  <section class="editorial-hero about-hero"><div class="wrap editorial-hero-grid"><div><div class="breadcrumbs"><a href={withBase('/')}>Главная</a><span>/</span><span>О компании</span></div><span class="eyebrow eyebrow-dark">{about.heroEyebrow}</span><h1>{about.heroTitle}</h1><p>{about.heroDescription}</p><button class="button" type="button" data-booking-open>Связаться с нами <span>↗</span></button></div><div class="about-visual"><img src={withBase(about.heroImage || '/images/gallery/china-01.webp')} alt="Пейзажи Китая" loading="lazy" /><span>САХЭКСПО<br /><b>РТО № 000321</b></span></div></div></section>
  <section class="section about-values"><div class="wrap"><span class="eyebrow eyebrow-dark">{about.valuesEyebrow}</span><h2>{about.valuesTitle}</h2><div class="about-value-grid">{about.values?.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section about-journey"><div class="wrap about-journey-grid"><div class="about-journey-copy"><span class="eyebrow eyebrow-dark">{about.journeyEyebrow}</span><h2>{about.journeyTitle}</h2>{about.journeyText?.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}<button class="button" type="button" data-booking-open>Задать вопрос о поездке <span aria-hidden="true">↗</span></button></div><div class="about-journey-card"><span class="eyebrow eyebrow-dark">САХЭКСПО · ХАБАРОВСК</span><h3>{about.checklistTitle}</h3><ul>{about.checklistItems?.map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="company-details"><div class="wrap company-details-grid"><div><span class="eyebrow">САХЭКСПО</span><h2>{about.companyTitle}</h2><p>{about.companyDescription}</p></div><div><strong>Офис в Хабаровске</strong><p>{settings.address}</p><a href={`tel:${settings.whatsAppNumber}`}>{settings.phone}</a><p><a href={settings.maxUrl} target="_blank" rel="noopener noreferrer">MAX</a> · <a href={`https://wa.me/${settings.whatsAppNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></p></div></div></section>
  <section class="about-office section"><div class="wrap"><div class="about-office-heading"><span class="eyebrow eyebrow-dark">{about.officeEyebrow}</span><h2>{about.officeTitle}</h2><p>{settings.address} · {settings.phone}</p></div><div class="about-office-map"><iframe src={`https://yandex.ru/map-widget/v1/?text=${encodeURIComponent(settings.address)}&z=16&lang=ru_RU`} title="Офис САХЭКСПО на карте Хабаровска" loading="lazy" allowfullscreen></iframe></div><a class="about-office-link" href={`https://yandex.ru/maps/?text=${encodeURIComponent(settings.address)}`} target="_blank" rel="noopener noreferrer">Открыть адрес в Яндекс Картах ↗</a></div></section>
</BaseLayout>
