---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import { withBase, tourPath } from '../../lib/paths';
export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { slug: tourPath(tour).replace(/^\/tur\//, '').replace(/\/$/, '') }, props: { tour } }));
}
const { tour } = Astro.props;
const { Content } = await render(tour);
const all = (await getCollection('tours')).filter((item) => item.id !== tour.id && !item.data.archived).slice(0, 3);
const tourVideos = (await getCollection('videos')).filter(({ data }) => !data.draft && data.tourSlugs?.includes(tour.id)).sort((a, b) => a.data.order - b.data.order);
const origin = 'https://sxpo.ru';
const canonicalPath = tourPath(tour);
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: origin },
    { '@type': 'ListItem', position: 2, name: 'Туры в Китай', item: `${origin}/#tours` },
    { '@type': 'ListItem', position: 3, name: tour.data.title, item: new URL(canonicalPath, origin).toString() },
  ],
};
---
<BaseLayout title={`${tour.data.title} из Хабаровска — САХЭКСПО`} description={tour.data.description} image={withBase(tour.data.images[0])} canonicalPath={canonicalPath}>
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
  <section class="tour-hero"><div class="wrap tour-hero-inner"><div class="breadcrumbs"><a href={withBase('/')}>Главная</a><span>/</span><a href={withBase('/#tours')}>Туры в Китай</a><span>/</span><span>{tour.data.title}</span></div><div class="tour-detail-grid"><div class="tour-detail-copy"><span class="eyebrow eyebrow-dark">{tour.data.category.toUpperCase()} · ИЗ ХАБАРОВСКА</span><h1>{tour.data.title}</h1><p class="tour-lead">{tour.data.description}</p><div class="detail-facts"><div><span>Длительность</span><strong>{tour.data.duration}</strong></div>{tour.data.schedule && <div><span>Расписание</span><strong>{tour.data.schedule}</strong></div>}</div><div class="detail-price">{tour.data.priceLabel?.startsWith('от ') && <span>Стоимость от</span>}<strong>{tour.data.priceLabel || 'Уточнить у менеджера'}</strong><small>Актуальную цену и даты подтвердите перед бронированием</small></div><button class="button tour-clarify-button" type="button" data-booking-tour={tour.data.title}>Уточнить даты и условия <span aria-hidden="true">↗</span></button></div><div class="swiper tour-slider" aria-label={`Фотографии тура «${tour.data.title}»`}><div class="swiper-wrapper">{tour.data.images.map((imgUrl, index) => <div class="swiper-slide"><button class="tour-slide-open" type="button" data-lightbox-group="tour" data-lightbox-src={withBase(imgUrl)} data-lightbox-alt={`${tour.data.destination} — ${tour.data.title}, фото ${index + 1}`} aria-label={`Открыть фото ${index + 1} во весь экран`}><img src={withBase(imgUrl)} alt={`${tour.data.destination} — ${tour.data.title}, фото ${index + 1}`} width="1200" height="800" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} /></button></div>)}</div><span class="image-caption">{tour.data.destination} · нажмите, чтобы увеличить</span><div class="swiper-pagination"></div><button class="swiper-button-prev" type="button" aria-label="Предыдущее фото"></button><button class="swiper-button-next" type="button" aria-label="Следующее фото"></button></div></div></div></section>
  {tour.data.hotelGalleries?.length > 0 && <section class="hotel-gallery-section"><div class="wrap"><div class="hotel-gallery-heading"><span class="eyebrow eyebrow-dark">РАЗМЕЩЕНИЕ</span><h2>Гостиницы в этом туре</h2><p>Посмотрите варианты размещения и выберите подходящий.</p></div>{tour.data.hotelGalleries.map((hotel) => <div class="hotel-gallery-group"><h3>{hotel.name}</h3><div class="hotel-gallery-track">{hotel.images.map((img, index) => <button class="hotel-photo" type="button" data-lightbox-group="hotels" data-lightbox-src={withBase(img)} data-lightbox-alt={`${hotel.name} — фото ${index + 1}`} aria-label={`Открыть фото гостиницы ${hotel.name}, фото ${index + 1}`}><img src={withBase(img)} alt={`${hotel.name} — фото ${index + 1}`} loading="lazy" decoding="async" width="480" height="340" /></button>)}</div></div>)}</div></section>}
  {tourVideos.length > 0 && <section class="section tour-video-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow eyebrow-dark">ВИДЕО ПО МАРШРУТУ</span><h2>Посмотрите, как это выглядит</h2></div></div><div class="video-library-grid">{tourVideos.map((video) => <article class="video-card"><div class="video-frame"><iframe src={video.data.vkEmbedUrl || (video.data.youtubeId ? `https://www.youtube-nocookie.com/embed/${video.data.youtubeId}` : video.data.vimeoId ? `https://player.vimeo.com/video/${video.data.vimeoId}` : '')} title={video.data.title} loading="lazy" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe></div><div><h2>{video.data.title}</h2><p>{video.data.description}</p></div></article>)}</div></div></section>}
  <section class="section tour-description"><div class="wrap description-layout"><aside><span class="eyebrow eyebrow-dark">ПЛАНИРУЕТЕ ПОЕЗДКУ?</span><h2>Поможем разобраться в деталях</h2><p>Подтвердим наличие мест, стоимость, гостиницу и условия поездки.</p><button class="button" type="button" data-booking-tour={tour.data.title}>Забронировать тур <span aria-hidden="true">↗</span></button></aside><article class="prose">
    {(tour.data.included.length > 0 || tour.data.notIncluded.length > 0) && <section class="tour-inclusions" aria-label="Что входит в стоимость тура">
      {tour.data.included.length > 0 && <div class="inclusion-card inclusion-card-included"><h2>В стоимость входит</h2><ul>{tour.data.included.map((item) => <li>{item}</li>)}</ul></div>}
      {tour.data.notIncluded.length > 0 && <div class="inclusion-card inclusion-card-extra"><h2>Оплачивается отдельно</h2><ul>{tour.data.notIncluded.map((item) => <li>{item}</li>)}</ul></div>}
    </section>}
    <Content /></article></div></section>
  <section class="section related-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow eyebrow-dark">МОЖЕТ ПОНРАВИТЬСЯ</span><h2>Ещё идеи для поездки</h2></div></div><div class="tour-grid">{all.map((item) => <TourCard tour={item} />)}</div></div></section>
  <dialog class="photo-lightbox" aria-label="Просмотр фотографии"><button class="lightbox-close" type="button" aria-label="Закрыть просмотр">×</button><button class="lightbox-arrow lightbox-prev" type="button" aria-label="Предыдущее фото">‹</button><figure><img alt="" /><figcaption></figcaption></figure><button class="lightbox-arrow lightbox-next" type="button" aria-label="Следующее фото">›</button></dialog>
</BaseLayout>
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sliderElement = document.querySelector('.tour-slider');
    if (!sliderElement || typeof Swiper === 'undefined') return;
    new Swiper(sliderElement, {
      loop: true,
      effect: 'slide',
      slidesPerView: 1,
      spaceBetween: 12,
      autoplay: false,
      pagination: { el: sliderElement.querySelector('.swiper-pagination'), clickable: true },
      navigation: { nextEl: sliderElement.querySelector('.swiper-button-next'), prevEl: sliderElement.querySelector('.swiper-button-prev') },
      a11y: { enabled: true },
    });

    const dialog = document.querySelector('.photo-lightbox');
    const lightboxImage = dialog?.querySelector('figure img');
    const caption = dialog?.querySelector('figcaption');
    let groupItems = [];
    let current = 0;
    const show = (index) => {
      current = (index + groupItems.length) % groupItems.length;
      const item = groupItems[current];
      lightboxImage.src = item.dataset.lightboxSrc;
      lightboxImage.alt = item.dataset.lightboxAlt || '';
      caption.textContent = item.dataset.lightboxAlt || '';
    };
    document.querySelectorAll('[data-lightbox-group]').forEach((item) => item.addEventListener('click', () => {
      groupItems = [...document.querySelectorAll(`[data-lightbox-group="${item.dataset.lightboxGroup}"]`)];
      show(groupItems.indexOf(item));
      dialog.showModal();
    }));
    dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    let touchStartX = 0;
    dialog?.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
    dialog?.addEventListener('touchend', (event) => {
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 45) show(current + (distance < 0 ? 1 : -1));
    }, { passive: true });
  });
</script>
