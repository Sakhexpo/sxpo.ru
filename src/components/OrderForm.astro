---
import { getCollection } from 'astro:content';
import settings from '../content/settings/site.json';
const tours = (await getCollection('tours')).filter(({ data }) => !data.archived).sort((a, b) => a.data.order - b.data.order);
const groupBy = (items, getKey) => items.reduce((groups, item) => {
  const key = getKey(item);
  (groups[key] ||= []).push(item);
  return groups;
}, {});
const tourGroups = groupBy(tours, (tour) => tour.data.destination || tour.data.category);
const uniqueHotels = tours.flatMap((tour) => tour.data.hotelGalleries.map((gallery) => ({ destination: tour.data.destination || tour.data.category, name: gallery.name })))
  .filter((hotel, index, hotels) => hotels.findIndex((item) => item.name === hotel.name) === index);
const hotelGroups = groupBy(uniqueHotels, (hotel) => hotel.destination);
const maxProfileUrl = settings.maxUrl;
const whatsAppUrl = `https://wa.me/${settings.whatsAppNumber}`;
---
<dialog class="booking-dialog" id="booking-dialog" aria-labelledby="booking-title">
  <div class="booking-dialog-inner">
    <button class="booking-close" type="button" aria-label="Закрыть форму" data-booking-close>×</button>
    <span class="eyebrow eyebrow-dark">ЗАЯВКА В САХЭКСПО</span>
    <h2 id="booking-title">Подберём поездку для вас</h2>
    <p class="booking-dialog-intro">Заполните форму — подготовим сообщение для выбранного мессенджера.</p>
    <form id="booking-form" class="lead-form">
      <label>Тур или направление
        <select name="tour" required aria-describedby="tour-help">
          <option value="">Выберите направление или конкретный тур</option>
          {Object.entries(tourGroups).map(([destination, destinationTours]) => (
            <optgroup label={destination}>
              {destinationTours.map((tour) => <option value={tour.data.title}>{tour.data.title} · {tour.data.duration}</option>)}
            </optgroup>
          ))}
          <option value="Помогите выбрать тур">Помогите выбрать тур</option>
        </select>
        <small class="booking-field-help" id="tour-help">Список сгруппирован по направлениям. Если сомневаетесь, выберите «Помогите выбрать тур».</small>
      </label>
      <div class="booking-form-row">
        <label>Количество человек
          <select name="guests" required>
            {Array.from({ length: 8 }, (_, index) => <option value={String(index + 1)} selected={index === 0}>{index + 1} {index === 0 ? 'человек' : 'человека'}</option>)}
            <option value="9+">9 и более</option>
          </select>
        </label>
        <label>Гостиница
          <select name="hotel" aria-describedby="hotel-help">
            <option value="">Помогите выбрать гостиницу</option>
            {Object.entries(hotelGroups).map(([destination, destinationHotels]) => (
              <optgroup label={destination}>
                {destinationHotels.map((hotel) => <option value={hotel.name}>{hotel.name}</option>)}
              </optgroup>
            ))}
            <option value="Другая гостиница — уточню с менеджером">Другая гостиница</option>
          </select>
          <small class="booking-field-help" id="hotel-help">Можно оставить этот вариант — менеджер поможет с размещением.</small>
        </label>
      </div>
      <label>Ваше имя<input type="text" name="name" autocomplete="name" placeholder="Как к вам обращаться" required /></label>
      <label>Телефон<input type="tel" name="phone" autocomplete="tel" inputmode="numeric" placeholder="+7 (___) ___-__-__" aria-describedby="phone-help" maxlength="18" required /><small class="booking-field-help" id="phone-help">Российский номер: 10 цифр после +7. Можно ввести номер с 8 или +7.</small></label>
      <div class="booking-channels">
        <button class="button whatsapp-button" type="submit" data-booking-channel="whatsapp"><span>Продолжить в WhatsApp</span><span aria-hidden="true">↗</span></button>
        <button class="button max-button booking-max-secondary" type="submit" data-booking-channel="max"><span>Продолжить в MAX</span><span aria-hidden="true">↗</span></button>
      </div>
      <p class="lead-consent" id="booking-status" aria-live="polite">Сообщение откроется в выбранном приложении. Проверьте его и нажмите «Отправить».</p>
    </form>
    <section class="booking-success" id="booking-success" hidden aria-live="polite">
      <span class="booking-success-icon" aria-hidden="true">✓</span>
      <h3>Заявка скопирована</h3>
      <p>Откройте MAX, нажмите «Написать» и вставьте подготовленный текст в сообщение.</p>
      <button class="button max-button" type="button" data-max-open>Открыть MAX <span aria-hidden="true">↗</span></button>
      <button class="booking-back" type="button" data-booking-back>Вернуться к форме</button>
    </section>
  </div>
</dialog>

<script is:inline define:vars={{ maxProfileUrl, whatsAppUrl }}>
  const bookingDialog = document.querySelector('#booking-dialog');
  const bookingForm = document.querySelector('#booking-form');
  const bookingStatus = document.querySelector('#booking-status');
  const tourSelect = bookingForm?.elements.namedItem('tour');
  const phoneInput = bookingForm?.elements.namedItem('phone');

  const formatRussianPhone = (value) => {
    const digits = value.replace(/\D/g, '');
    if (!digits) return '';
    const national = (digits.startsWith('7') || digits.startsWith('8') ? digits.slice(1) : digits).slice(0, 10);
    let formatted = '+7';
    if (national.length) formatted += ` (${national.slice(0, 3)}`;
    if (national.length >= 3) formatted += ')';
    if (national.length > 3) formatted += ` ${national.slice(3, 6)}`;
    if (national.length > 6) formatted += `-${national.slice(6, 8)}`;
    if (national.length > 8) formatted += `-${national.slice(8, 10)}`;
    return formatted;
  };

  phoneInput?.addEventListener('input', () => {
    const beforeCaret = phoneInput.value.slice(0, phoneInput.selectionStart || 0).replace(/\D/g, '');
    const rawDigits = phoneInput.value.replace(/\D/g, '');
    const caretDigits = Math.max(0, beforeCaret.length - (rawDigits.startsWith('7') || rawDigits.startsWith('8') ? 1 : 0));
    phoneInput.value = formatRussianPhone(phoneInput.value);
    const caretNationalDigits = Math.min(caretDigits, 10);
    let caret = 2;
    let foundDigits = 0;
    while (caret < phoneInput.value.length && foundDigits < caretNationalDigits) {
      if (/\d/.test(phoneInput.value[caret])) foundDigits += 1;
      caret += 1;
    }
    phoneInput.setSelectionRange(caret, caret);
    const valid = /^\+7 \(\d{3}\) \d{3}-\d{2}-\d{2}$/.test(phoneInput.value);
    phoneInput.setCustomValidity(valid || !phoneInput.value ? '' : 'Введите российский номер полностью: 10 цифр после +7.');
  });

  document.querySelectorAll('[data-booking-open], [data-booking-tour]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const requestedTour = trigger.dataset.bookingTour;
      if (requestedTour && tourSelect) {
        const option = [...tourSelect.options].find((item) => item.value === requestedTour);
        tourSelect.value = option ? requestedTour : 'Помогите выбрать тур';
      }
      bookingDialog?.showModal();
      window.setTimeout(() => bookingForm?.elements.namedItem('name')?.focus(), 80);
    });
  });

  document.querySelector('[data-booking-close]')?.addEventListener('click', () => bookingDialog?.close());
  bookingDialog?.addEventListener('click', (event) => {
    if (event.target === bookingDialog) bookingDialog.close();
  });

  const bookingSuccess = document.querySelector('#booking-success');
  const maxOpenButton = document.querySelector('[data-max-open]');
  maxOpenButton?.addEventListener('click', () => window.open(maxProfileUrl, '_blank', 'noopener,noreferrer'));
  document.querySelector('[data-booking-back]')?.addEventListener('click', () => {
    bookingSuccess.hidden = true;
    bookingForm.hidden = false;
  });

  bookingForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!bookingForm.reportValidity()) return;

    const submitter = event.submitter;
    const formData = new FormData(bookingForm);
    const message = [
      'Здравствуйте! Хочу забронировать тур САХЭКСПО.',
      '',
      `Тур: ${formData.get('tour')}`,
      `Имя: ${formData.get('name')}`,
      `Телефон: ${formData.get('phone')}`,
      `Количество человек: ${formData.get('guests')}`,
      `Гостиница: ${formData.get('hotel') || 'Нужна помощь с выбором'}`,
    ].join('\n');

    if (submitter?.dataset.bookingChannel === 'whatsapp') {
      window.open(`${whatsAppUrl}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      bookingStatus.textContent = 'Сообщение подготовлено в WhatsApp. Проверьте данные и нажмите «Отправить».';
      return;
    }

    try {
      await navigator.clipboard.writeText(message);
      bookingForm.hidden = true;
      bookingSuccess.hidden = false;
    } catch {
      window.prompt('Скопируйте текст заявки и вставьте его в MAX:', message);
      bookingForm.hidden = true;
      bookingSuccess.hidden = false;
    }
  });
</script>
