---
import type { CollectionEntry } from 'astro:content';
import { withBase, withBaseSrcset, tourPath } from '../lib/paths';
type Props = { tour: CollectionEntry<'tours'> };
const { tour } = Astro.props;
const href = withBase(tourPath(tour));
---
<article class="tour-card bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col h-full" data-tour-card data-category={tour.data.category} data-reveal>
  <a class="tour-image-link" href={href} aria-label={`Подробнее: ${tour.data.title}`}>
    <img class="tour-image" src={withBase(tour.data.images[0])} srcset={withBaseSrcset(tour.data.imageSrcset)} sizes="(max-width: 620px) 100vw, (max-width: 850px) 50vw, 33vw" alt={tour.data.destination} loading="lazy" decoding="async" width="720" height="480" />
    <span class="duration-badge">◷ {tour.data.duration}</span>
    <span class="image-label">{tour.data.category}</span>
  </a>
  <div class="tour-card-body">
    {tour.data.schedule && <div class="tour-meta"><span>{tour.data.schedule}</span></div>}
    <h3><a href={href}>{tour.data.title}</a></h3>
    <p>{tour.data.description}</p>
    <div class="tour-card-bottom"><span class="price">{tour.data.priceLabel || 'Уточнить цену'}</span><a class="card-more-button" href={href}>Подробнее <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
